 const HERMES_HOME = resolveHermesHome()
 
+// Windows installs provision a managed Git/SSH client under HERMES_HOME.
+// Prefer that known runtime, while preserving System OpenSSH for installs
+// where the managed bundle is absent.
+function desktopSshExecutable() {
+  if (!IS_WINDOWS) {
+    return 'ssh'
+  }
+
+  const managed = path.join(HERMES_HOME, 'git', 'usr', 'bin', 'ssh.exe')
+
+  return fs.existsSync(managed)
+    ? managed
+    : path.join(process.env.SystemRoot || 'C:\\Windows', 'System32', 'OpenSSH', 'ssh.exe')
+}
+
+function spawnDesktopSsh(command, args, options) {
+  return spawn(command === 'ssh' ? desktopSshExecutable() : command, args, options)
+}
